# Copiar a .env y completar. El .env nunca se sube al repo.

# ---- Docker en el VPS (no se pisan con Casa Roma, el robot ni Nutrimapache) ----
STACK=gastosapp
WEB_PORT=8093
MONGO_PORT=27023
DOMAIN=

# ---- API ----
MONGO_URL=mongodb://localhost:27017/gastosapp
# Admin inicial: se crea al arrancar si no hay ningún admin. Los demás usuarios se crean desde el panel.
# En el VPS el script de deploy genera la contraseña solo.
ADMIN_USERNAME=mati
ADMIN_PASSWORD=
# Carga por texto ("café 2500 mp") y por foto del ticket con Claude. La clave va SOLO acá.
# Puede ser la misma que usan Nutrimapache y Casa Roma. Sin clave, esas opciones no aparecen.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# Tope de consultas a la IA por persona por día
AI_DAILY_LIMIT=40
